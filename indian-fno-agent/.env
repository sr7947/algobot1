# ============================================================
# Indian F&O Trading Agent — Environment Configuration
# ============================================================
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="Indian F&O Trading Agent"
VERSION="1.0.0"
DEBUG=false

# Trading mode: PAPER (default, safe) | LIVE | SHADOW
# WARNING: Set to LIVE only after thorough paper trading validation
TRADING_MODE=PAPER

LOG_LEVEL=INFO

# ------------------------------------------------------------
# DATABASE
# PostgreSQL (main database)
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fnoagent:changeme@localhost:5432/fnoagent
REDIS_URL=redis://localhost:6379/0
# TimescaleDB (optional, for OHLCV time-series)
TIMESCALE_URL=postgresql+asyncpg://fnoagent:changeme@localhost:5433/fnoagent_ts

# ------------------------------------------------------------
# BROKER SELECTION
# Options: angel_one | dhan | groww | paper
# ------------------------------------------------------------
BROKER=delta_exchange

# Angel One SmartAPI
ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_client_id_here
ANGEL_ONE_PASSWORD=your_trading_password_here
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here

# Delta Exchange (Crypto Futures & Options Testnet)
DELTA_ENV=paper
DELTA_API_KEY=E6fdLpC7vDp5FBN7HByFmnf5ObquZ7
DELTA_API_SECRET=qj83Snblfzy436fViBWtTgvq9TPxOAaNV0UOAUqIHWyTPHbQHtyLS98VTt3V

# Dhan (placeholder — not yet implemented)
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_CLIENT_ID=your_dhan_client_id_here

# Groww (placeholder — not yet implemented)
GROWW_ACCESS_TOKEN=your_groww_access_token_here

# ------------------------------------------------------------
# TELEGRAM
# Setup guide: see docs/telegram_setup.md
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8835997624:AAGk8cXjHmch75NiKCXk2VjgZviwK9UZ2Ew
TELEGRAM_CHAT_ID=1120838189
TELEGRAM_APPROVAL_TIMEOUT_MINUTES=15

# ------------------------------------------------------------
# GOOGLE GEMINI API
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# NEWS API
# ------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here
NEWS_FETCH_INTERVAL_MINUTES=15

# ------------------------------------------------------------
# RISK MANAGEMENT
# ------------------------------------------------------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=5
MAX_EXPOSURE_PER_SYMBOL_PCT=20.0
SLIPPAGE_PCT=0.1
MIN_LIQUIDITY_VOLUME=1000
MAX_CONSECUTIVE_LOSSES=3
TOTAL_CAPITAL=500000

# ------------------------------------------------------------
# MARKET SCHEDULE (IST)
# ------------------------------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_MARKET_TIME=09:00
NO_NEW_ENTRY_TIME=14:30
SIGNAL_SCAN_INTERVAL_SECONDS=60

# ------------------------------------------------------------
# FILE PATHS
# ------------------------------------------------------------
DATA_DIR=./data
LOG_DIR=./logs
BACKTEST_DIR=./backtests

# ------------------------------------------------------------
# DASHBOARD / API
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=changeme_generate_a_real_secret_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------
# ADVANCED / OPTIONAL
# ------------------------------------------------------------
AUTONOMOUS_MODE=false
WATCHLIST=NIFTY,BANKNIFTY,FINNIFTY,RELIANCE,HDFC,TCS,INFY,ICICIBANK,KOTAKBANK,AXISBANK
DEFAULT_PRODUCT_TYPE=INTRADAY
ENABLE_VOICE_NOTES=false
