# ============================================================
# Indian F&O Trading Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="Indian F&O Trading Agent"
VERSION="1.0.0"
DEBUG=false

# Trading mode: PAPER (default, safe) | LIVE | SHADOW
# WARNING: Set to LIVE only after thorough paper trading validation
TRADING_MODE=PAPER

LOG_LEVEL=INFO

# ------------------------------------------------------------
# DATABASE
# PostgreSQL (main database)
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fnoagent:changeme@localhost:5432/fnoagent
REDIS_URL=redis://localhost:6379/0
# TimescaleDB (optional, for OHLCV time-series)
TIMESCALE_URL=postgresql+asyncpg://fnoagent:changeme@localhost:5433/fnoagent_ts

# ------------------------------------------------------------
# BROKER SELECTION
# Options: angel_one | dhan | groww | paper
# ------------------------------------------------------------
BROKER=angel_one

# Angel One SmartAPI
# Get from: https://smartapi.angelbroking.com/
ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_client_id_here
ANGEL_ONE_PASSWORD=your_trading_password_here
# TOTP Secret: shown when enabling 2FA on Angel One (store this securely)
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here

# Dhan (placeholder — not yet implemented)
# Get from: https://dhanhq.co/docs/v2/
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_CLIENT_ID=your_dhan_client_id_here

# Delta Exchange (Crypto Futures & Options)
# Testnet: https://cdn-ind.testnet.deltaex.org | Live: https://api.india.delta.exchange
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_ENV=paper
# Default order leverage for crypto futures (25 = 25x; margin ≈ notional / leverage)
DELTA_DEFAULT_LEVERAGE=25

# Groww (placeholder — not yet implemented)
# Get from: https://developers.groww.in/
GROWW_ACCESS_TOKEN=your_groww_access_token_here

# ------------------------------------------------------------
# TELEGRAM
# Setup guide: see docs/telegram_setup.md
# ------------------------------------------------------------
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Minutes to wait for approval before signal expires
TELEGRAM_APPROVAL_TIMEOUT_MINUTES=15

# ------------------------------------------------------------
# GOOGLE GEMINI API
# Setup guide: see docs/gemini_setup.md
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# NEWS API
# Get from: https://newsapi.org (free tier: 100 req/day)
# ------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here
NEWS_FETCH_INTERVAL_MINUTES=15

# ------------------------------------------------------------
# RISK MANAGEMENT
# Tune these carefully — they are your safety net
# ------------------------------------------------------------
# Maximum risk per trade as % of total capital
MAX_RISK_PER_TRADE_PCT=1.0

# Maximum daily loss before kill switch activates
MAX_DAILY_LOSS_PCT=3.0

# Maximum simultaneous open positions
MAX_OPEN_POSITIONS=5

# Maximum exposure to any single symbol as % of capital
MAX_EXPOSURE_PER_SYMBOL_PCT=20.0

# Slippage to account for in P&L calculations
SLIPPAGE_PCT=0.1

# Minimum option liquidity (volume) to consider for trading
MIN_LIQUIDITY_VOLUME=1000

# Stop trading after this many consecutive losses
MAX_CONSECUTIVE_LOSSES=3

# Total capital for position sizing (your actual trading capital)
TOTAL_CAPITAL=500000

# ------------------------------------------------------------
# MARKET SCHEDULE (IST)
# ------------------------------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
# Pre-market scan start
PRE_MARKET_TIME=09:00
# No new entries after this time
NO_NEW_ENTRY_TIME=14:30
# Signal scan interval in seconds
SIGNAL_SCAN_INTERVAL_SECONDS=60

# ------------------------------------------------------------
# FILE PATHS
# ------------------------------------------------------------
DATA_DIR=./data
LOG_DIR=./logs
BACKTEST_DIR=./backtests

# ------------------------------------------------------------
# DASHBOARD / API
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Secret key for JWT tokens — generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_real_secret_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=1440

# Dashboard CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------
# ADVANCED / OPTIONAL
# ------------------------------------------------------------
# Enable autonomous mode (NO Telegram approval required)
# WARNING: Use only in paper mode for testing
AUTONOMOUS_MODE=false

# Watchlist symbols (comma-separated NSE F&O symbols)
WATCHLIST=NIFTY,BANKNIFTY,FINNIFTY,RELIANCE,HDFC,TCS,INFY,ICICIBANK,KOTAKBANK,AXISBANK

# Default holding type: INTRADAY | CARRY
DEFAULT_PRODUCT_TYPE=INTRADAY

# Enable voice note summaries via Gemini (future feature)
ENABLE_VOICE_NOTES=false
